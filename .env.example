# ==============================================================================
# Agro Rate Tracker — Environment Configuration
# ==============================================================================

# 1. SAP HANA Cloud MCP Server Database (Enterprise In-Memory Column Store)
# Matches MCP Server configuration: hana-mcp-server
HANA_HOST="your-instance.hana.prod-ap21.hanacloud.ondemand.com"
HANA_PORT="443"
HANA_USER="YOUR_HANA_USER"
HANA_PASSWORD="YOUR_HANA_PASSWORD"
HANA_SCHEMA="07083DD5224243A8B73B330781FE33B6"
HANA_SSL="true"
HANA_SSL_VALIDATE_CERTIFICATE="false"
HANA_SSL_CRYPTO_PROVIDER="openssl"
HANA_SSL_TRUST_STORE=""

# 2. Supabase PostgreSQL Cloud Database (Optional Hybrid Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# 3. Government of India Open Data API (Agmarknet Mandi Feed)
DATA_GOV_IN_API_KEY=""
DATA_GOV_IN_RESOURCE_ID="9ef84268-d588-465a-a308-a864a43d0070"

# 4. Server & Application URL
PORT=3000
APP_URL="http://localhost:3000"
